# When running via `docker compose up` (the self-hosted deploy), Mongo runs
# as its own "mongo" container on the same compose network -- leave this
# exactly as-is, no signup/account needed:
MONGODB_URI=mongodb://mongo:27017
#
# For local dev *without* Docker Compose (running `uvicorn` directly), spin
# up a throwaway local Mongo yourself and point at it instead, e.g.:
#   docker run -d --name conscient-dev-mongo -p 27017:27017 mongo:7
#   MONGODB_URI=mongodb://localhost:27017

MONGODB_DB_NAME=conscient
JWT_SECRET=replace-with-a-long-random-string

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
